# Copiar este archivo a ".env" y completar con tus propios valores.
# El archivo ".env" nunca se sube al repositorio (ver .gitignore).
#
# Si dejás todo vacío, el script corre igual: usa automáticamente un dataset
# público de demostración (Adult Income, atributo sensible "sex") para que
# puedas ver el flujo completo funcionando antes de cargar tu propio dataset.

# Ruta a tu dataset propio (CSV), dentro de data/. Ej: data/mi_dataset.csv
# Dejar vacío para usar el dataset de demostración.
DATASET_PATH=

# Nombre de la columna objetivo (la que el modelo predice) en tu CSV.
TARGET_COLUMN=

# Nombre de la columna con el atributo sensible a auditar (ej. género, raza, edad).
SENSITIVE_ATTRIBUTE=

# Valor de TARGET_COLUMN que se considera "clase positiva" (ej. "Sí", "1", ">50K").
# Requerido si tu columna objetivo no es ya 0/1.
POSITIVE_LABEL=

# Técnica de mitigación de Fairlearn a aplicar: "exponentiated_gradient",
# "threshold_optimizer", o "ambos" para comparar las dos en la misma corrida.
MITIGATION_METHOD=exponentiated_gradient

# Restricción de equidad que la mitigación intenta satisfacer: "demographic_parity"
# o "equalized_odds".
FAIRNESS_CONSTRAINT=demographic_parity
